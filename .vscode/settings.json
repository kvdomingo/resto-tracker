{
  "python.defaultInterpreterPath": "./api/.venv/bin/python",
  "sqlfluff.executablePath": "./api/.venv/bin/sqlfluff",
  "sqlfluff.config": "./api/pyproject.toml",
  "ty.configurationFile": "./api/pyproject.toml",
  "ty.interpreter": "./api/.venv/bin/python",
  "ruff.configuration": "./api/pyproject.toml",
  "ruff.path": ["./api/.venv/bin/ruff"],
  "prettier.enable": false,
  "biome.enabled": true,
  "biome.configurationPath": "./ui/biome.json",
  "biome.lsp.bin": "./ui/node_modules/.bin/biome",
  "[javascript][typescript][javascriptreact][typescriptreact][html][css][json][jsonc][vue][astro]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "biomejs.biome",
    "editor.codeActionsOnSave": {
      "source.organizeImports.biome": "explicit",
      "source.fixAll.biome": "explicit"
    },
    "editor.indentSize": 2
  }
}
